# Snapshot date fixed by the assignment
AS_OF=2026-10-26

# Synthetic source size (assignment default 300000; lower for faster local runs)
N_PRICES=50000

# PostgreSQL (source + DWH)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=deals_bigdata
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ClickHouse
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=deals_mart

# Pipeline window (full history by default)
ETL_START_DATE=2023-06-01
ETL_END_DATE=2027-03-31

# Airflow (on Windows Docker Desktop use 0)
AIRFLOW_UID=0
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin
AIRFLOW__CORE__LOAD_EXAMPLES=false

# Random seed for ML
RANDOM_SEED=42